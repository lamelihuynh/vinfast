{
    "name": "vinfast/website",
    "description": "VinFast website — hybrid PostgreSQL + MongoDB",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo_pgsql": "*",
        "ext-mongodb": "*",
        "mongodb/mongodb": "^2.1"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "db:seed": "php database/seed/seed.php"
    }
}
